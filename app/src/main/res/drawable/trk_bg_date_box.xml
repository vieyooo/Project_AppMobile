<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Warna latar belakang kotak tanggal (abu-abu sangat terang / putih bersih) -->
    <solid android:color="#F8F9FA" />

    <!-- Sudut melengkung untuk kotaknya (radius 8dp) -->
    <corners android:radius="8dp" />

    <!-- Garis tepi (stroke) tipis agar kotak tanggal terlihat berbatas rapi -->
    <stroke
        android:width="1dp"
        android:color="#E9EBEE" />

</shape>