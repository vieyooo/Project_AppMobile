<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Warna latar belakang kotak info (abu-abu sangat terang / lembut) -->
    <solid android:color="#F8F9FA" />

    <!-- Sudut melengkung untuk kotaknya (radius 12dp) -->
    <corners android:radius="12dp" />

    <!-- Garis tepi (stroke) tipis agar kotak terlihat tegas dan rapi -->
    <stroke
        android:width="1dp"
        android:color="#E9ECEF" />

</shape>