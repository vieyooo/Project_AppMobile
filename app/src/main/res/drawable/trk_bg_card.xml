<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Warna latar belakang kartu (putih bersih) -->
    <solid android:color="#FFFFFF" />

    <!-- Sudut melengkung kartu (radius 14dp agar terlihat modern/rounded) -->
    <corners android:radius="14dp" />

    <!-- Garis tepi (stroke) tipis untuk mempertegas batasan kartu -->
    <stroke
        android:width="1dp"
        android:color="#E9EBEE" />

</shape>