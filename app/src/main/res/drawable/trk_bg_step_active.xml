<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Warna latar belakang untuk langkah yang sedang aktif (oranye muda/krem terang yang lembut) -->
    <solid android:color="#FDF2E9" />

    <!-- Sudut melengkung untuk kotaknya (radius 12dp) -->
    <corners android:radius="12dp" />

    <!-- Garis tepi (stroke) tipis agar kotak aktif terlihat tegas -->
    <stroke
        android:width="1dp"
        android:color="#F39C12" />

</shape>