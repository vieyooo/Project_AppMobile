<?xml version="1.0" encoding="utf-8"?>
<!-- Pertemuan 4: RelativeLayout
     Posisi view ditentukan relatif terhadap view lain / parent:
     layout_below, layout_toEndOf, layout_toStartOf, layout_alignParent*, layout_alignBottom -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stepRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- Kiri: lingkaran nomor (menempel di kiri-atas parent) -->
    <TextView
        android:id="@+id/tvStepNumber"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="1dp"
        android:background="@drawable/trk_bg_circle_step"
        android:gravity="center"
        android:textColor="@color/trk_white"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Kiri: garis penghubung.
         Mulai di bawah lingkaran (layout_below) dan memanjang sampai bagian
         bawah kolom judul (layout_alignBottom). -->
    <View
        android:id="@+id/viewConnector"
        android:layout_width="2dp"
        android:layout_height="wrap_content"
        android:layout_alignStart="@id/tvStepNumber"
        android:layout_alignBottom="@id/stepMiddle"
        android:layout_below="@id/tvStepNumber"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp" />

    <!-- Kanan: jam (menempel di kanan-atas parent) -->
    <TextView
        android:id="@+id/tvStepTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:fontFamily="monospace"
        android:textColor="@color/trk_text_muted"
        android:textSize="11sp" />

    <!-- Tengah: judul + keterangan (di kanan lingkaran, di kiri jam) -->
    <LinearLayout
        android:id="@+id/stepMiddle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="12dp"
        android:layout_toStartOf="@id/tvStepTime"
        android:layout_toEndOf="@id/tvStepNumber"
        android:orientation="vertical"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStepTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/trk_text_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStepBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/trk_bg_badge_small"
                android:fontFamily="monospace"
                android:paddingStart="5dp"
                android:paddingTop="1dp"
                android:paddingEnd="5dp"
                android:paddingBottom="1dp"
                android:text="BERJALAN"
                android:textColor="@color/trk_white"
                android:textSize="8sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStepSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/trk_text_muted"
            android:textSize="11sp" />
    </LinearLayout>
</RelativeLayout>