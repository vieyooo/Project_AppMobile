                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Pelacakan"
                android:textColor="#8A7A5C"
                android:textSize="11sp" />
