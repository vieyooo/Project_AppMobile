<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/trk_bg_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Judul + tombol tutup -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="KONTAK PENGEMUDI"
                android:textColor="@color/trk_text_muted"
                android:textSize="9sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Driver Truk Pengangkut"
                android:textColor="@color/trk_text_dark"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnDialogClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/trk_bg_icon_button"
            android:clickable="true"
            android:contentDescription="Tutup"
            android:focusable="true"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/trk_text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Profil driver -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivDialogAvatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/trk_bg_avatar"
            android:clipToOutline="true"
            android:contentDescription="Foto driver"
            android:scaleType="centerCrop"
            android:src="@drawable/foto_budi" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDialogDriverName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/trk_text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@drawable/trk_bg_badge_neutral"
                android:fontFamily="monospace"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="TERVERIFIKASI"
                android:textColor="@color/trk_text_muted"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDialogDriverRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/trk_text_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Kotak info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/trk_bg_info_box"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="4dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="NOMOR HP"
                android:textColor="@color/trk_text_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvDialogPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/trk_text_dark"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/trk_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="KENDARAAN"
                android:textColor="@color/trk_text_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvDialogVehicle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/trk_text_dark"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/trk_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="ESTIMASI TIBA"
                android:textColor="@color/trk_text_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tvDialogEta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/trk_orange"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tombol -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDialogCall"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:text="TELEPON"
        android:textColor="@color/trk_white"
        android:textStyle="bold"
        app:backgroundTint="@color/trk_primary"
        app:cornerRadius="12dp"
        app:icon="@drawable/trk_ic_phone"
        app:iconGravity="textStart"
        app:iconTint="@color/trk_white" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDialogMessage"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="8dp"
        android:text="KIRIM PESAN"
        android:textColor="@color/trk_primary"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:strokeColor="@color/trk_line" />

    <TextView
        android:id="@+id/btnDialogDismiss"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:text="Tutup"
        android:textColor="@color/trk_text_muted"
        android:textSize="13sp" />
</LinearLayout>