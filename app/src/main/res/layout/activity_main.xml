<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFAF0"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- ===== TOP BAR (kuning, jadi pemisah tegas dengan konten) ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FBBF24"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="38dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="46dp"
            android:layout_height="46dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Logo TitanRent"
                android:padding="6dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_logo" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.03"
                android:text="TITANRENT"
                android:textColor="#3B2400"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:text="SEWA ALAT BERAT &amp; OPERATOR"
                android:textColor="#7A4A00"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Toolbar transparan: hanya dipakai sebagai tempat Options Menu (titik tiga) -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:minHeight="48dp"
            android:theme="@style/ThemeOverlay.TitanRent.Toolbar" />
    </LinearLayout>

    <!-- ===== SHEET: menimpa top bar sehingga tepinya melengkung ===== -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="-24dp"
        android:layout_weight="1"
        app:cardBackgroundColor="#FFFAF0"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Header section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="22dp"
                android:paddingBottom="12dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="5dp"
                    android:layout_height="34dp"
                    app:cardBackgroundColor="#A85A00"
                    app:cardCornerRadius="3dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="KATALOG UTAMA"
                        android:textColor="#3B2400"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.08"
                        android:text="ALAT BERAT SIAP OPERASI"
                        android:textColor="#8A7A5C"
                        android:textSize="9sp" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FEF3C7"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#FDE68A"
                    app:strokeWidth="1dp"/>
            </LinearLayout>

            <!-- ===== DAFTAR UNIT: tinggi kartu TETAP (92dp), tidak ikut jumlah kartu ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <!-- UNIT 1 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardUnit1"
                    android:layout_width="match_parent"
                    android:layout_height="92dp"
                    android:layout_marginBottom="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:strokeColor="#F6E7B8"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            app:cardBackgroundColor="#FEF3C7"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Foto unit"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_excavator" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-black"
                                android:maxLines="1"
                                android:text="Excavator CAT 336D L"
                                android:textColor="#3B2400"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:fontFamily="monospace"
                                android:maxLines="1"
                                android:text="Bucket 1.9 m³ · 36.2 T"
                                android:textColor="#8A7A5C"
                                android:textSize="10sp" />

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                app:cardBackgroundColor="#FEF3C7"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="3dp">

                                    <com.google.android.material.card.MaterialCardView
                                        android:layout_width="6dp"
                                        android:layout_height="6dp"
                                        app:cardBackgroundColor="#A85A00"
                                        app:cardCornerRadius="3dp"
                                        app:cardElevation="0dp"
                                        app:strokeWidth="0dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:fontFamily="monospace"
                                        android:text="Siap Kirim · Pool A"
                                        android:textColor="#92400E"
                                        android:textSize="9sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="Rp 4.500.000"
                                android:textColor="#A85A00"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="/ HARI"
                                android:textColor="#8A7A5C"
                                android:textSize="9sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- UNIT 2 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardUnit2"
                    android:layout_width="match_parent"
                    android:layout_height="92dp"
                    android:layout_marginBottom="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:strokeColor="#F6E7B8"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            app:cardBackgroundColor="#FEF3C7"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Foto unit"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_bulldozer" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-black"
                                android:maxLines="1"
                                android:text="Bulldozer CAT D6R"
                                android:textColor="#3B2400"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:fontFamily="monospace"
                                android:maxLines="1"
                                android:text="Blade 3.8 m³ · 20.5 T"
                                android:textColor="#8A7A5C"
                                android:textSize="10sp" />

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                app:cardBackgroundColor="#FEF3C7"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="3dp">

                                    <com.google.android.material.card.MaterialCardView
                                        android:layout_width="6dp"
                                        android:layout_height="6dp"
                                        app:cardBackgroundColor="#A85A00"
                                        app:cardCornerRadius="3dp"
                                        app:cardElevation="0dp"
                                        app:strokeWidth="0dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:fontFamily="monospace"
                                        android:text="Siap Kirim · Pool A"
                                        android:textColor="#92400E"
                                        android:textSize="9sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="Rp 3.800.000"
                                android:textColor="#A85A00"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="/ HARI"
                                android:textColor="#8A7A5C"
                                android:textSize="9sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- UNIT 3 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardUnit3"
                    android:layout_width="match_parent"
                    android:layout_height="92dp"
                    android:layout_marginBottom="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:strokeColor="#F6E7B8"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            app:cardBackgroundColor="#FEF3C7"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Foto unit"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_motorgrader" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-black"
                                android:maxLines="1"
                                android:text="Motor Grader CAT 140"
                                android:textColor="#3B2400"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:fontFamily="monospace"
                                android:maxLines="1"
                                android:text="Moldboard 4.2 m · 19.0 T"
                                android:textColor="#8A7A5C"
                                android:textSize="10sp" />

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                app:cardBackgroundColor="#FEF3C7"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="3dp">

                                    <com.google.android.material.card.MaterialCardView
                                        android:layout_width="6dp"
                                        android:layout_height="6dp"
                                        app:cardBackgroundColor="#A85A00"
                                        app:cardCornerRadius="3dp"
                                        app:cardElevation="0dp"
                                        app:strokeWidth="0dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:fontFamily="monospace"
                                        android:text="Siap Kirim · Pool A"
                                        android:textColor="#92400E"
                                        android:textSize="9sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="Rp 4.100.000"
                                android:textColor="#A85A00"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="/ HARI"
                                android:textColor="#8A7A5C"
                                android:textSize="9sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- UNIT 4 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardUnit4"
                    android:layout_width="match_parent"
                    android:layout_height="92dp"
                    android:layout_marginBottom="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:strokeColor="#F6E7B8"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            app:cardBackgroundColor="#FEF3C7"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Foto unit"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_wheelloader" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-black"
                                android:maxLines="1"
                                android:text="Wheel Loader CAT 950 GC"
                                android:textColor="#3B2400"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:fontFamily="monospace"
                                android:maxLines="1"
                                android:text="Bucket 3.1 m³ · 18.6 T"
                                android:textColor="#8A7A5C"
                                android:textSize="10sp" />

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                app:cardBackgroundColor="#FEF3C7"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="3dp">

                                    <com.google.android.material.card.MaterialCardView
                                        android:layout_width="6dp"
                                        android:layout_height="6dp"
                                        app:cardBackgroundColor="#A85A00"
                                        app:cardCornerRadius="3dp"
                                        app:cardElevation="0dp"
                                        app:strokeWidth="0dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:fontFamily="monospace"
                                        android:text="Siap Kirim · Pool C"
                                        android:textColor="#92400E"
                                        android:textSize="9sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="Rp 3.500.000"
                                android:textColor="#A85A00"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="/ HARI"
                                android:textColor="#8A7A5C"
                                android:textSize="9sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ===== INFO STRIP ===== -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="#FEF3C7"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="#FDE68A"
        app:strokeWidth="1dp"/>

    <!-- ===== BOTTOM NAVIGATION (manual) ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="10dp"
        android:orientation="horizontal"
        android:paddingVertical="6dp">

        <!-- Katalog (aktif) -->
        <LinearLayout
            android:id="@+id/navCatalog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="56dp"
                android:layout_height="30dp"
                app:cardBackgroundColor="#FDE68A"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🏗️"
                    android:textSize="17sp" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Katalog"
                android:textColor="#A85A00"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Operator -->
        <LinearLayout
            android:id="@+id/navOperator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="56dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="👷"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Operator"
                android:textColor="#8A7A5C"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Pelacakan -->
        <LinearLayout
            android:id="@+id/navTracking"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="56dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="🚚"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Pelacakan"
                android:textColor="#8A7A5C"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Lainnya -->
        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="56dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="⚙️"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Lainnya"
                android:textColor="#8A7A5C"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>